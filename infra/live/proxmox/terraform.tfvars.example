# infra/live/proxmox/terraform.tfvars.example
# Copie para terraform.tfvars e preencha os valores

proxmox_api_url    = "https://proxmox.artjason.com/"
proxmox_api_token  = "terraform@pve!mytoken=SEU_TOKEN_AQUI"
proxmox_node       = "proxmox-a"
proxmox_ssh_host   = "192.168.15.199"
proxmox_node_b     = "proxmox-b"
proxmox_ssh_host_b = "192.168.15.198"
proxmox_datastore  = "local-lvm"
proxmox_bridge     = "vmbr0"

# Necessario apenas para VMs com auth_mode = "password"
# Gere com: openssl passwd -6 'sua-senha'
vm_password_hash = ""
